// Sail configuration for cv64a6_imafdchsclic_sv39_hpdcache_wb in the cva6tb testbench.
// The memory map mirrors test/hw/cva6tb_pkg.sv; keep the two in step.
// SPDX-License-Identifier: Apache-2.0
// ACT requires Sail's simple_interrupt_generator for signature generation,
// even though this DUT has no such device: it lives at 0x9000_0000, the first
// address above DRAM, so it collides with nothing in hw/cva6tb_pkg.sv.
{
  "$schema": "https://github.com/riscv/sail-riscv/releases/download/0.14.1/sail_riscv_config_schema.json",
  "base": {
    "xlen": 64,
    "E": false,
    "writable_misa": false,
    "writable_fiom": true,
    // Measured on the DUT: writing all ones to mcountinhibit reads back 0x1fd,
    // i.e. CY (0), IR (2) and the six HPM counters 3-8 that ariane_pkg's
    // MHPMCounterNum provides. TM (1) is absent because the time CSR is not
    // implemented. Counters 9 and above read back zero.
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x0000_01fd"
    },
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    // Measured: all 32 bits writable, as for mcounteren and scounteren.
    "hcounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    // In vectored mode csr_regfile.sv clears mtvec[7:1] on write, so the base
    // is 256-byte aligned there -- a stricter constraint than the 4 bytes the
    // specification requires, which it permits. Direct mode keeps the 4 bytes.
    // stvec and vstvec are aligned the same way in vectored mode.
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 8
      }
    },
    "stvec": {
      "direct": {
        "supported": true
      },
      "vectored": {
        "supported": true,
        "base_alignment": 8
      }
    },
    "vstvec": {
      "direct": {
        "supported": true
      },
      "vectored": {
        "supported": true,
        "base_alignment": 8
      }
    },
    // Measured on the DUT by writing all ones to medeleg and reading back; it
    // matches the mask built in csr_regfile.sv. Bits 0-8 and 12/13/15 are the
    // base causes, bit 10 is the VS-mode ecall and bits 20-23 the guest page
    // faults and virtual instruction, both groups present because RVH is set.
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x0000_0000_00f0_b5ff"
      }
    },
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0000_2222"
      }
    },
    // CVA6 sets TvalEn, so xtval carries the faulting address (or, for an
    // illegal instruction, the encoding) for every exception the core can
    // raise. These must agree with the REPORT_*_IN_*TVAL_ON_* parameters in
    // config.yaml: ACT computes the expected signatures on Sail, so a "false"
    // here would expect a zero xtval the DUT never produces.
    // software_check, hardware_error and the reserved causes are unreachable on
    // this core; hardware_breakpoint needs Sdtrig, which this configuration
    // leaves out.
    "xtval_nonzero": {
      "illegal_instruction": true,
      "virtual_instruction": true,
      "load_guest_page_fault": true,
      "samo_guest_page_fault": true,
      "fetch_guest_page_fault": true,
      "software_breakpoint": true,
      "hardware_breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": true,
      "software_check": false,
      "hardware_error": false,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      "fs_legal_states": "ExtContext_FourState",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_12"
  },
