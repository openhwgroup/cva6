@@ -39,7 +39,9 @@ module AsyncDpRam
   logic [DATA_WIDTH-1:0] mem [DATA_DEPTH-1:0]= '{default:0};
 
   // WRITE
-  always_ff @(posedge Clk_CI)
+  // always, not always_ff: mem also has an initial value, and always_ff
